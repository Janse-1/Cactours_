# =============================================================================
# CACTOURS - Plantilla Global de Variables de Entorno (.env.example)
# Copia este archivo como `.env` en cada servicio correspondiente y configura
# tus valores locales. NUNCA subas archivos `.env` reales al repositorio.
# =============================================================================

# --- Entorno General ---
DJANGO_ENV=dev
# Opciones: dev | prod

# --- Seguridad Django (cactours_backend) ---
DJANGO_SECRET_KEY=cambia-esta-clave-secreta-en-tu-entorno-local
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de Datos (cactours_backend) ---
# En desarrollo puedes usar 'mysql' o 'sqlite' (para pruebas rápidas sin servidor MySQL)
DB_ENGINE=mysql
DB_NAME=cactours_db
DB_USER=cactours_app_user
DB_PASSWORD=pon_aqui_tu_password_seguro
DB_HOST=localhost
DB_PORT=3306

# --- CORS & Orígenes Permitidos (Web Vue.js y Móvil React Native) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081

# --- Frontend Web Vue.js (cactours_frontend) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_MEDIA_BASE_URL=http://localhost:8000

# --- Móvil React Native + Expo (cactours_mobile) ---
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api/v1
