# =============================================================================
# CACTOURS BACKEND (Django REST API) - .env.example
# Copia este archivo a `cactours_backend/.env` y configura tus credenciales.
# =============================================================================

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=reemplazar-por-clave-secreta-segura-generada
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Motor de base de datos: 'mysql' (producción/estándar) o 'sqlite' (desarrollo rápido/CI)
DB_ENGINE=mysql
DB_NAME=cactours_db
DB_USER=cactours_user
DB_PASSWORD=cambiar_este_password
DB_HOST=localhost
DB_PORT=3306

# Orígenes permitidos para Vue.js (5173) y Expo Web/Metro (8081)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081

# Configuración de Tokens / Sesión API
API_TOKEN_TTL_HOURS=24
